extends SceneTree

func _initialize() -> void:
    call_deferred("run_tests")

func run_tests() -> void:
    var robot := Robot3D.new()
    root.add_child(robot)
    robot.state = UpgradeState.new()
    robot.definitions["minigun"] = load("res://data/minigun.tres")
    robot.state.upgrade("minigun")
    robot.refresh()
    assert(robot.parts.get_child_count() == 1)
    assert(robot.base_parts.get_child_count() == 11)
    var gun := robot.parts.get_child(0)
    assert(gun.get_children().any(func(node): return node is MeshInstance3D and node.mesh is CylinderMesh))
    var first := robot.parts.get_child(0).get_child_count()
    robot.state.upgrade("minigun")
    robot.refresh()
    assert(robot.parts.get_child(0).get_child_count() > first)
    assert(robot.sockets.size() == 8)
    assert(robot.sockets["right_arm"].get_parent() is BoneAttachment3D)
    assert(robot.sockets["right_arm"].get_parent().bone_name == "LowerArm.R")
    assert(robot.animation.has_animation("Walk"))
    assert(robot.animation.current_animation == "Walk")
    var marker := Marker3D.new()
    robot.add_child(marker)
    marker.set_meta("rest_basis", Basis.IDENTITY)
    var test_part := Node3D.new()
    robot.add_child(test_part)
    marker.rotation.z = 0.7
    robot.follow_bone(test_part, marker, false)
    assert(test_part.basis.orthonormalized().is_equal_approx(Basis(Vector3.FORWARD, -0.7)))
    robot.queue_free()
    print("3D-Bauteiltests bestanden")
    quit()
